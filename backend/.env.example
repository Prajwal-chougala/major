PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/wattwise?appName=Cluster0

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

CLIENT_URL=http://localhost:3000

RATE_PER_KWH=8

# Twilio (https://console.twilio.com) - used to send SMS & WhatsApp power alerts.
# Leave blank during local dev: in-app alerts still work, but SMS is not delivered.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS-capable Twilio sender number in international format (e.g. +14155551234).
TWILIO_PHONE_NUMBER=
# Default Twilio WhatsApp sandbox number is +14155238886
TWILIO_WHATSAPP_NUMBER=+14155238886

# Minutes a device is allowed to stay over its powerLimit before it's
# automatically turned off. Can be overridden per device.
AUTO_OFF_MINUTES=5

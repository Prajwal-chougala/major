PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/wattwise?appName=Cluster0

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

CLIENT_URL=http://localhost:3000

RATE_PER_KWH=8

# Fast2SMS Quick SMS API key (https://www.fast2sms.com/)
FAST2SMS_API_KEY=replace_with_fast2sms_api_key
AUTO_OFF_MINUTES=5
# Optional destination used only by `npm run test:sms`
TEST_SMS_NUMBER=

# SMTP Email (used to send email alerts when daily limit is exceeded).
# Leave blank during local dev: emails fall back to console logging instead.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

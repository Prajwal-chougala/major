PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/wattwise?appName=Cluster0

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

CLIENT_URL=http://localhost:3000

RATE_PER_KWH=8

# Fast2SMS Quick SMS API key (India-only SMS recipients).
FAST2SMS_API_KEY=

# Minutes a device is allowed to stay over its powerLimit before it's
# automatically turned off. Can be overridden per device.
AUTO_OFF_MINUTES=5

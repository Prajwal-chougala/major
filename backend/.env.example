PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/wattwise?appName=Cluster0

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

CLIENT_URL=http://localhost:3000

RATE_PER_KWH=8

# Twilio (https://console.twilio.com) - used to send SMS power alerts.
# Leave blank during local dev: alerts fall back to console logging instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Minutes a device is allowed to stay over its powerLimit before it's
# automatically turned off. Can be overridden per device.
AUTO_OFF_MINUTES=5

PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/wattwise?appName=Cluster0

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1h

CLIENT_URL=http://localhost:3000

RATE_PER_KWH=8

# Twilio (https://console.twilio.com) - used to send SMS power alerts.
# Leave blank during local dev: alerts fall back to console logging instead.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# SMTP Email (used to send email alerts when daily limit is exceeded).
# Leave blank during local dev: emails fall back to console logging instead.
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
